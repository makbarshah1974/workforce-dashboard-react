{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:node": "tsx src/node-server.ts",
    "build": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "tsx src/db/push.ts",
    "db:seed": "tsx src/db/seed.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.5.4",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hono/node-server": "^2.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}